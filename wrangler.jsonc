{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Deploy with scripts/cf.mjs (npm run cf:deploy:production), which refuses to deploy
  // while a REPLACE_ value remains. This file describes PRODUCTION only. UAT was removed
  // from the config for now; its Worker and D1 still exist in Cloudflare.
  "account_id": "7c744d89a9c22ae3cdd2ae56f60024f4",
  "name": "vastuvihar-website",
  // Wraps the OpenNext worker to add the daily retention job (cloudflare/worker.ts).
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // Off: the site is served on vastuvihar.com, and a workers.dev copy would route around
  // the WAF. The noindex marking in cloudflare/worker.ts stays as a fallback.
  "workers_dev": false,
  "preview_urls": false,
  // 02:00 IST daily. A no-op until retention periods are approved in the admin panel.
  "triggers": { "crons": ["30 20 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vastuvihar-db",
      "database_id": "be4de6b9-143d-4d75-87a8-1f3b96a17b48",
      "migrations_dir": "migrations"
    }
  ],
  // TEMPORARY: R2 is not enabled on the account yet, so the buckets are not bound and file
  // uploads answer "File storage is not available". Once R2 is on, create both buckets
  // (public access off) and uncomment this block.
  // "r2_buckets": [
  //   { "binding": "PRIVATE_FILES", "bucket_name": "vastuvihar-private" },
  //   { "binding": "MEDIA", "bucket_name": "vastuvihar-media" }
  // ],
  "vars": {
    "APP_ENV": "production",
    // Set by Cloudflare on every request, and a client cannot forge it.
    "CLIENT_IP_HEADER": "cf-connecting-ip",
    // Cloudflare Access is OFF for now, by the owner's decision: Access could not be set up.
    // The admin login is the only gate, and its master account accepts only the
    // ADMIN_PASSWORD secret (16+ characters). To turn Access on, set this to "1" and fill
    // the two values below (lib/security/cfAccess.ts).
    "REQUIRE_CF_ACCESS": "0",
    "CF_ACCESS_TEAM_DOMAIN": "REPLACE_WITH_TEAM.cloudflareaccess.com",
    "CF_ACCESS_AUD": "REPLACE_WITH_PRODUCTION_ACCESS_AUD"
  },
  // Secrets (npx wrangler secret put <NAME>): PRIVACY_HASH_SECRET, RETENTION_CRON_SECRET.
  // ADMIN_PASSWORD (16+ characters) enables the master admin login; ADMIN_EMAIL is optional.
}
